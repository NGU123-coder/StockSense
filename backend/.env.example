# --- required ---
DATABASE_URL=postgresql://stocksense:stocksense@localhost:5432/stocksense
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
INTERNAL_API_KEY=shared-secret-with-the-forecast-service

# --- defaults shown ---
PORT=4000
REDIS_URL=redis://localhost:6379
CLIENT_ORIGIN=http://localhost:5173
FORECAST_SERVICE_URL=http://localhost:8000
ENABLE_JOBS=true
# For a frontend on a different domain (Vercel) than the API (Render):
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true

# --- optional: real email for alerts and purchase orders (otherwise logged to the console) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=StockSense <alerts@yourcompany.in>
# ALERT_EMAIL_TO=purchase-team@yourcompany.in
